APP_ENV=development
APP_NAME=Atenas
APP_VERSION=0.1.0
TIMEZONE=UTC
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# Max Telegram document upload size in MB (Bot API download cap is 20)
TELEGRAM_MAX_UPLOAD_MB=20
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_CHAT_ID=
DEADLINE_ALERT_HOURS=72
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SMALL_MODEL=llama3.2
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
CLOUD_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ENABLE_CLOUD_FALLBACK=false
MAX_CLOUD_COST_PER_DAY_USD=1.00
MAX_CLOUD_CALLS_PER_DAY=50
MIN_CONFIDENCE_THRESHOLD=0.65
MAX_LLM_RETRIES=2
LOG_LEVEL=INFO
# Comma-separated private/loopback CIDRs allowed to reach the local-only API/dashboard
# (e.g. a Docker bridge gateway). Empty = loopback only. 0.0.0.0/0 and public ranges are rejected.
TRUSTED_CLIENT_NETWORKS=
# Two short lines in the dashboard header stamp. Line 2 defaults to the timezone city.
DASHBOARD_STAMP_LINE1=LOCAL STUDY DESK
DASHBOARD_STAMP_LINE2=
# docker compose only: override where the container finds Ollama (default http://host.docker.internal:11434)
# DOCKER_OLLAMA_BASE_URL=http://ollama:11434
